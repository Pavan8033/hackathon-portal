rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Problems Collection
    match /problems/{problemId} {
      // Participants can ONLY read PUBLISHED problems
      // Admins can read DRAFT, SCHEDULED, PUBLISHED, ARCHIVED
      allow read: if resource.data.status == 'PUBLISHED' || isAdmin();
      
      // Only authenticated admins can create or delete problems
      allow create, delete: if isAdmin();

      // Admins can update all fields; participants can ONLY increment selectedCount by 1
      allow update: if isAdmin() || (
        resource.data.status == 'PUBLISHED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedCount', 'updatedAt']) &&
        request.resource.data.selectedCount == resource.data.selectedCount + 1
      );
    }

    // 2. Teams Collection (Portal directory, credentials, and roster sync)
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // 2b. Participants Roster Collection
    match /participants/{teamId} {
      allow read, write: if true;
    }

    // 2c. Deleted Teams Tombstones Collection
    match /deletedTeams/{teamId} {
      allow read, write: if true;
    }

    // 3. Team Selections Collection (Atomic 1 problem per team)
    match /teamSelections/{teamId} {
      allow read, write: if true;
    }

    // 4. Portal Settings Collection
    match /settings/{settingId} {
      // Everyone can read settings; allow write so changes never disappear on reload
      allow read, write: if true;
    }

    // 5. Announcements Collection
    match /announcements/{announcementId} {
      // Participants can read published announcements; admins can read all
      allow read: if resource.data.status == 'PUBLISHED' || isAdmin();

      // Only admins can create, edit, or delete announcements
      allow write: if isAdmin();
    }

    // 6. Audit Logs Collection
    match /auditLogs/{logId} {
      // Only admins can view audit logs
      allow read: if isAdmin();

      // System or Admin can append audit records
      allow create: if request.resource.data.action is string && request.resource.data.timestamp is string;
      allow update, delete: if isAdmin();
    }

    // 7. Users / Admins Metadata
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
