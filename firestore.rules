rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Problems Collection
    match /problems/{problemId} {
      // Participants can ONLY read PUBLISHED problems
      // Admins can read DRAFT, SCHEDULED, PUBLISHED, ARCHIVED
      allow read: if resource.data.status == 'PUBLISHED' || isAdmin();
      
      // Only authenticated admins can create or delete problems
      allow create, delete: if isAdmin();

      // Admins can update all fields; participants can ONLY increment selectedCount by 1
      allow update: if isAdmin() || (
        resource.data.status == 'PUBLISHED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedCount', 'updatedAt']) &&
        request.resource.data.selectedCount == resource.data.selectedCount + 1
      );
    }

    // 2. Teams Collection
    match /teams/{teamId} {
      // Allow read for portal directory and credential validation
      allow read: if true;

      // Only admins can import, create, or delete teams directly
      allow create, delete: if isAdmin();
      
      // Allowed updates: admin can update anything; teams can only link their selection
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selectedProblemId', 'selectedProblemTitle', 'selectionDate', 'updatedAt'])
      );
    }

    // 3. Team Selections Collection (Atomic 1 problem per team)
    match /teamSelections/{teamId} {
      // Allow read so teams and admins can view selection status
      allow read: if true;

      // Team can create selection if they don't already have one (ATOMIC LOCK)
      allow create: if isAdmin() || (
        !exists(/databases/$(database)/documents/teamSelections/$(teamId)) &&
        request.resource.data.teamId == teamId &&
        request.resource.data.status == 'CONFIRMED' &&
        request.resource.data.problemId is string &&
        request.resource.data.selectedAt is string
      );

      // Teams CANNOT update or delete their selection once confirmed (LOCKED)
      // Only admins can reset or delete selections
      allow update, delete: if isAdmin();
    }

    // 4. Portal Settings Collection
    match /settings/{settingId} {
      // Everyone can read settings (selection open/closed, countdown, deadlines)
      allow read: if true;

      // Only admins can update portal settings
      allow write: if isAdmin();
    }

    // 5. Announcements Collection
    match /announcements/{announcementId} {
      // Participants can read published announcements; admins can read all
      allow read: if resource.data.status == 'PUBLISHED' || isAdmin();

      // Only admins can create, edit, or delete announcements
      allow write: if isAdmin();
    }

    // 6. Audit Logs Collection
    match /auditLogs/{logId} {
      // Only admins can view audit logs
      allow read: if isAdmin();

      // System or Admin can append audit records
      allow create: if request.resource.data.action is string && request.resource.data.timestamp is string;
      allow update, delete: if isAdmin();
    }

    // 7. Users / Admins Metadata
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
